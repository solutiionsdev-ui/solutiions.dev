# Resend — transactional email for the contact form (§12)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@solutiions.dev
CONTACT_FROM_EMAIL="Solutiions.dev <noreply@solutiions.dev>"

# Upstash Redis — distributed rate limiting for the contact Server Action (§12).
# An in-memory bucket is NOT a rate limiter on Vercel: every serverless instance
# keeps its own map and cold starts reset it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Absolute origin, used for canonical URLs, sitemap and OG image resolution.
NEXT_PUBLIC_SITE_URL=https://solutiions.dev
